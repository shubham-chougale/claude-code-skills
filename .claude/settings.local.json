{
  "description": "Local development overrides - not committed to git",

  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(all)",
      "PowerShell(all)"
    ]
  },

  "skills": {
    "get-trending-in-AI": {
      "enabled": true,
      "auto_open_browser": true,
      "verbose_logging": true,
      "debug_mode": false
    },
    "frontend-design": {
      "enabled": true,
      "verbose_logging": false
    },
    "db-migration-resolver": {
      "enabled": true,
      "verbose_logging": false,
      "require_user_approval_for_destructive": true
    },
    "auto-docs": {
      "enabled": true,
      "verbose_logging": false,
      "show_progress_during_init": true
    }
  },

  "features": {
    "auto_browser_open": {
      "enabled": true
    },
    "deduplication_engine": {
      "enabled": true,
      "strict_mode": false
    }
  },

  "development": {
    "auto_format_on_save": true,
    "type_check_on_save": true,
    "lint_on_save": true,
    "verbose_output": false,
    "debug_mode": false
  }
}
