    "sequence-diagram":    ["api_change", "new_feature", "feature_modified"],
    "erd":                 ["db_schema_change", "migration_file_committed"],
    "data-flow":           ["new_feature", "infra_change", "feature_modified"],
    "user-flow":           ["ui_change", "new_feature", "feature_removed"],
    "api-lifecycle":       ["api_change", "infra_change", "new_feature"],
    "deployment-topology": ["infra_change", "new_service_added"],
    "cicd-pipeline":       ["infra_change", "pipeline_file_committed"],
    "git-branching":       ["branching_strategy_change"]
  },

  "maintenance_hooks": {
    "on_commit": {
      "enabled": true,
      "auto_update_checks": [
        {"pattern": "migrations/|*_migration.*|*.sql", "updates_doc": "DATABASE", "flags_diagram": "erd"},
        {"pattern": "routes/|controllers/|api/|endpoints/|views/", "updates_doc": "API", "flags_diagram": ["sequence-diagram", "api-lifecycle"]},
        {"pattern": "package.json|requirements.txt|Podfile|build.gradle|go.mod", "updates_doc": "SETUP"},
        {"pattern": ".env.example", "updates_doc": "SETUP"},
        {"pattern": "src/components/|components/", "updates_doc": "COMPONENT_DOC"},
        {"pattern": "src/modules/|src/services/", "updates_doc": "MODULE_DOC"},
        {"pattern": "*", "updates_doc": "CHANGELOG"}
      ],
      "flag_only_checks": [
        {"pattern": "infra/|terraform/|*.tf", "flags_doc": "INFRA", "flags_diagram": "deployment-topology"},
        {"pattern": ".github/workflows/|Jenkinsfile|.gitlab-ci.yml", "flags_doc": "CICD", "flags_diagram": "cicd-pipeline"},
        {"pattern": "docker-compose.yml|Dockerfile", "flags_doc": "INFRA", "flags_diagram": "deployment-topology"},
        {"pattern": "new_top_level_directory", "flags_doc": ["HLD", "LLD"], "flags_diagram": "system-architecture"}
      ]
    },
    "on_pr": {
      "enabled": true,
      "action": "staleness_check",
      "comment_if_stale": true,
      "block_merge": false
    },
    "sprint_end_audit": {
      "enabled": true,
      "action": "full_staleness_report",
      "output": "stale_doc_report"
    },
    "on_release": {
      "enabled": true,
      "actions": [
        "generate_release_notes_from_changelog",
        "snapshot_all_docs",
        "update_api_doc_version"
      ]
    }
  },

  "auto_update_rules": {
    "fully_automatic": ["CHANGELOG", "DATABASE", "API", "SETUP"],
    "flagged_for_human": ["FRD", "HLD", "LLD", "DEPLOY", "CICD", "INFRA", "TEST_PLAN"],
    "human_only": ["BRD", "SCOPE", "UAT", "POSTMORTEM", "GIT_STRATEGY", "CODING_STANDARDS", "ROLLBACK", "INCIDENT_RESPONSE", "MONITORING", "BUG_REPORT"],
    "template_only": ["TEST_CASES"],
    "review_required": ["RELEASE_NOTES"]
  },

  "tone_rules": {
    "active_voice": true,
    "present_tense": true,
    "max_sentence_length": 20,
    "no_filler_phrases": [
      "In this document we will",
      "This document aims to",
      "The purpose of this document",
      "As mentioned above",
      "It is important to note"
    ],
    "style": "senior_developer_wrote_it",
    "specificity": "numbers_over_vague_claims"
  },

  "last_updated_header_format": {
    "template": "---\nlast_updated: YYYY-MM-DD\nchanged: [plain English description]\nupdated_by: [role]\nsprint: [sprint number]\n---",
    "inject_on": "every_doc_update",
    "position": "top_of_file"
  },

  "audit_output": {
    "format": "sprint_report",
    "sections": ["up_to_date", "needs_update", "missing"],
    "include_action_items": true,
    "staleness_check_against": "last_updated_header"
  },

  "folder_structure": {
    "base": "/docs",
    "always_created": [
      "/docs/requirements/",
      "/docs/architecture/",
      "/docs/guides/",
      "/docs/testing/",
      "/docs/deployment/",
      "/docs/ops/",
      "/docs/ops/postmortems/",
      "/docs/diagrams/",
      "/docs/releases/"
    ],
    "conditional": {
      "web_app": ["/docs/components/"],
      "mobile_ios": ["/docs/modules/"],
      "mobile_android": ["/docs/modules/"],
      "fullstack": ["/docs/components/", "/docs/modules/"]
    },
    "root_files": ["/CHANGELOG.md", "/DOC_OWNERS.md"],
    "hooks_folder": "/.claude/hooks/",
    "git_hooks_folder": "/.githooks/",
    "ci_workflow_file": "/.github/workflows/doc-check.yml"
  },

  "hook_layers": {
    "layer_1_git_hooks": {
      "location": "/.githooks/",
      "files": ["post-commit", "post-commit.ps1", "pre-push", "install.sh", "install.ps1"],
      "fires_when": "git commit, git push",
      "works_outside_claude": true
    },
    "layer_2_claude_hooks": {
      "location": ".claude/settings.json (hooks block)",
      "config_source": "/.claude/hooks/claude-hooks.json",
      "fires_when": "Claude PostToolUse, Stop, UserPromptSubmit",
      "works_outside_claude": false
    },
    "layer_3_ci_pr_check": {
      "location": "/.github/workflows/doc-check.yml",
      "fires_when": "Pull request opened or updated",
      "works_outside_claude": true
    },
    "layer_4_sprint_audit": {
      "location": "/.claude/hooks/scripts/audit_docs.py",
      "fires_when": "/auto-docs audit, cron schedule, or manual",
      "works_outside_claude": true
    }
  },

  "performance": {
    "init_time_estimate_seconds": 30,
    "audit_time_estimate_seconds": 15,
    "max_execution_time_seconds": 60
  }
}
