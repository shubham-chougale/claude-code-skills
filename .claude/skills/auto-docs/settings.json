{
  "skill_metadata": {
    "name": "auto-docs",
    "version": "1.0.0",
    "description": "Automated documentation generation and lifetime maintenance for any project. One command at project start — docs maintain themselves forever.",
    "author": "Development Team",
    "created_date": "2026-05-21",
    "last_updated": "2026-05-21",
    "category": "Documentation & Project Management",
    "tags": ["documentation", "automation", "project-setup", "maintenance", "BRD", "FRD", "changelog", "API-docs"],
    "enabled": true
  },

  "commands": {
    "init": {
      "description": "Initialize complete documentation system for a new project",
      "usage": "/auto-docs init",
      "questions_count": 5,
      "generates": [
        "folder_structure",
        "document_templates",
        "diagram_html_files",
        "changelog",
        "doc_owners",
        "doc_maintenance_rules",
        "hooks_folder_with_scripts",
        "git_hooks",
        "github_actions_ci",
        "claude_code_hooks_config"
      ],
      "total_documents_created": 26,
      "total_diagrams_created": 9,
      "hook_layers_installed": 4
    },
    "audit": {
      "description": "Run staleness check across all docs — use at sprint end or before release",
      "usage": "/auto-docs audit",
      "output": "stale_doc_report"
    }
  },

  "project_types": {
    "web_app": {
      "label": "Web App",
      "extra_docs": ["components"],
      "stack_hints": ["React", "Vue", "Angular", "Svelte", "HTML/CSS/JS"],
      "skips": ["mobile_modules"]
    },
    "mobile_ios": {
      "label": "Mobile (iOS)",
      "extra_docs": ["modules"],
      "stack_hints": ["Swift", "SwiftUI", "UIKit", "Objective-C"],
      "skips": ["components", "android_modules"]
    },
    "mobile_android": {
      "label": "Mobile (Android)",
      "extra_docs": ["modules"],
      "stack_hints": ["Kotlin", "Java", "Jetpack Compose"],
      "skips": ["components", "ios_modules"]
    },
    "api_only": {
      "label": "API Only",
      "extra_docs": ["openapi"],
      "stack_hints": ["Django", "FastAPI", "Node/Express", "Rails", "Spring"],
      "skips": ["components", "mobile_modules"]
    },
    "fullstack": {
      "label": "Fullstack",
      "extra_docs": ["components", "modules", "openapi"],
      "stack_hints": ["Any combination"],
      "skips": []
    }
  },

